#!/usr/bin/env python3
"""Review a GitHub pull request diff with Antigravity CLI and optionally post it."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

MARKER = "<!-- agy-pr-review -->"
REPO_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
FENCED_CODE_PATTERN = re.compile(r"(?m)^[ \t]*```")
MAX_COMMENT_BYTES = 60000
DEFAULT_MAX_DIFF_BYTES = 300000
DEFAULT_MODEL = "Gemini 3.1 Pro (High)"


class CommandExecutionError(Exception):
    def __init__(self, command: list[str], returncode: int, stdout: str, stderr: str) -> None:
        self.command = command
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        super().__init__("명령 실행 실패")

    def format(self) -> str:
        output = (self.stderr or "") + (self.stdout or "")
        return f"명령 실행 실패: {' '.join(self.command)}\n{output}"


def run(command: list[str], *, cwd: Path, input_text: str | None = None) -> str:
    result = subprocess.run(
        command,
        cwd=cwd,
        input=input_text,
        text=True,
        encoding="utf-8",
        errors="replace",
        capture_output=True,
    )
    if result.returncode != 0:
        raise CommandExecutionError(command, result.returncode, result.stdout or "", result.stderr or "")
    return result.stdout


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise SystemExit(f"'{name}' 명령을 찾을 수 없습니다. PATH를 확인해주세요.")


def load_json(raw: str, context: str) -> Any:
    try:
        return json.loads(raw or "null")
    except json.JSONDecodeError as exc:
        raise SystemExit(f"{context} JSON 파싱에 실패했습니다: {exc}") from exc


def current_repo(cwd: Path) -> str:
    return run(["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"], cwd=cwd).strip()


def pr_diff(repo: str, pr_number: str, cwd: Path) -> str:
    return run(["gh", "pr", "diff", pr_number, "--repo", repo], cwd=cwd)


def ensure_diff_size(diff: str, max_diff_bytes: int) -> None:
    diff_size = utf8_size(diff)
    if diff_size > max_diff_bytes:
        raise SystemExit(
            f"PR diff가 너무 큽니다: {diff_size} bytes > {max_diff_bytes} bytes. "
            "PR을 더 작은 단위로 나누거나 --max-diff-bytes 값을 조정해주세요."
        )


def build_prompt(repo: str, pr_number: str, diff: str) -> str:
    return f"""현재 GitHub PR diff를 코드 리뷰 관점으로 검토해주세요.

중요:
- 파일을 수정하지 마세요.
- 명령어를 실행하지 마세요.
- 커밋하지 마세요.
- 리뷰 코멘트만 한국어로 작성하세요.

검토 기준:
- 요구사항 충족 여부
- 버그 가능성
- 아키텍처/레이어 경계 위반
- 테스트/검증 부족
- 보안/권한/데이터 처리 리스크
- 불필요한 복잡도
- 문서/템플릿 표현의 모호함
- 머지 전 확인 사항

출력 형식:
1. 반드시 수정해야 할 항목
2. 수정하면 좋은 항목
3. 문제 없음
4. 머지 전 확인 사항

대상:
- 저장소: {repo}
- PR: #{pr_number}

PR diff:
<pr_diff>
{diff}
</pr_diff>
"""


def review_with_agy(prompt: str, timeout: str, cwd: Path, model: str) -> str:
    command = ["agy", "--print", "--print-timeout", timeout, "--model", model]
    return run(command, cwd=cwd, input_text=prompt).strip()


def utf8_size(text: str) -> int:
    return len(text.encode("utf-8"))


def trim_to_utf8_bytes(text: str, max_bytes: int) -> str:
    lines: list[str] = []
    current_size = 0
    for line in text.splitlines(keepends=True):
        line_size = utf8_size(line)
        if current_size + line_size > max_bytes:
            break
        lines.append(line)
        current_size += line_size
    if lines:
        return "".join(lines)
    return text.encode("utf-8")[:max_bytes].decode("utf-8", errors="ignore")


def truncate_comment_body(body: str) -> str:
    if utf8_size(body) <= MAX_COMMENT_BYTES:
        return body

    suffix = "\n\n---\n리뷰 결과가 GitHub 댓글 길이 제한에 가까워 일부 내용을 생략했습니다. 더 작은 PR 단위로 나눠 다시 실행해주세요.\n"
    closing_fence = "\n```\n"
    safe_limit = MAX_COMMENT_BYTES - utf8_size(suffix) - utf8_size(closing_fence)
    truncated = trim_to_utf8_bytes(body, safe_limit)

    if len(FENCED_CODE_PATTERN.findall(truncated)) % 2 == 1:
        truncated += closing_fence

    return truncated + suffix


def comment_body(repo: str, pr_number: str, model: str, review: str) -> str:
    generated_at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    body = f"""{MARKER}
## Antigravity 리뷰 결과

- 대상: `{repo}#{pr_number}`
- 생성 시각: `{generated_at}`
- 실행 명령: `scripts/agy-pr-review {pr_number} --post`
- 모델: `{model}`

{review}
"""
    return truncate_comment_body(body)


def gh_api(
    path: str,
    cwd: Path,
    method: str = "GET",
    payload: dict | None = None,
    paginate: bool = False,
    slurp: bool = False,
) -> str:
    command = ["gh", "api", "-H", "Accept: application/vnd.github+json", "-H", "Content-Type: application/json"]
    if method != "GET":
        command.extend(["-X", method])
    if paginate:
        command.append("--paginate")
    if slurp:
        command.append("--slurp")
    command.append(path)
    input_text = None
    if payload is not None:
        command.extend(["--input", "-"])
        input_text = json.dumps(payload, ensure_ascii=False)
    return run(command, cwd=cwd, input_text=input_text)


def flatten_comments(raw_comments: Any) -> list[dict]:
    if raw_comments is None:
        return []
    if isinstance(raw_comments, list) and raw_comments and isinstance(raw_comments[0], list):
        return [comment for page in raw_comments for comment in page]
    if isinstance(raw_comments, list):
        return raw_comments
    raise SystemExit("GitHub 댓글 목록 응답 형식이 예상과 다릅니다.")


def viewer_login(cwd: Path) -> str:
    try:
        viewer = load_json(gh_api("user", cwd), "GitHub 사용자 정보")
    except CommandExecutionError as exc:
        raise SystemExit(
            "GitHub 사용자 로그인 정보를 확인할 수 없습니다. gh auth status를 확인해주세요.\n"
            + exc.format()
        ) from exc

    if not isinstance(viewer, dict):
        raise SystemExit("GitHub 사용자 정보가 올바른 형식이 아닙니다. gh auth status를 확인해주세요.")

    login = viewer.get("login")
    if login:
        return login
    raise SystemExit("GitHub 사용자 정보에서 login 필드를 찾을 수 없습니다. gh auth status를 확인해주세요.")


def post_or_update_comment(repo: str, pr_number: str, body: str, cwd: Path) -> str:
    login = viewer_login(cwd)
    comments_raw = gh_api(f"repos/{repo}/issues/{pr_number}/comments", cwd, paginate=True, slurp=True)
    comments = flatten_comments(load_json(comments_raw, "GitHub PR 댓글 목록"))

    for comment in comments:
        user = comment.get("user") or {}
        comment_body_text = comment.get("body") or ""
        if user.get("login") == login and comment_body_text.strip().startswith(MARKER):
            comment_id = comment.get("id")
            if not comment_id:
                continue
            gh_api(f"repos/{repo}/issues/comments/{comment_id}", cwd, method="PATCH", payload={"body": body})
            return "updated"

    gh_api(f"repos/{repo}/issues/{pr_number}/comments", cwd, method="POST", payload={"body": body})
    return "created"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Antigravity CLI(agy)로 PR diff를 리뷰하고 GitHub PR 댓글로 남깁니다.",
    )
    parser.add_argument("pr_number", help="리뷰할 Pull Request 번호")
    parser.add_argument("--repo", help="owner/repo 형식의 저장소명. 생략하면 현재 저장소를 사용합니다.")
    parser.add_argument("--post", action="store_true", help="리뷰 결과를 PR 댓글로 생성하거나 기존 agy 리뷰 댓글을 갱신합니다.")
    parser.add_argument("--timeout", default="5m", help="agy --print-timeout 값입니다. 기본값: 5m")
    parser.add_argument("--model", default=DEFAULT_MODEL, help=f"agy에서 사용할 모델을 지정합니다. 기본값: {DEFAULT_MODEL}")
    parser.add_argument("--max-diff-bytes", type=int, default=DEFAULT_MAX_DIFF_BYTES, help="agy에 전달할 PR diff의 최대 UTF-8 바이트 수입니다. 기본값: 300000")
    args = parser.parse_args()

    if not args.pr_number.isdigit():
        parser.error("pr_number는 숫자만 입력해주세요. 예: scripts/agy-pr-review 12")
    if args.repo and not REPO_PATTERN.fullmatch(args.repo):
        parser.error("--repo는 owner/repo 형식이어야 합니다. 예: documind-ai-lab/documind-client")

    return args


def main() -> int:
    args = parse_args()
    cwd = Path.cwd()

    try:
        require_command("gh")
        require_command("agy")

        repo = args.repo or current_repo(cwd)
        if not REPO_PATTERN.fullmatch(repo):
            raise SystemExit(f"저장소 이름이 owner/repo 형식이 아닙니다: {repo}")

        diff = pr_diff(repo, args.pr_number, cwd)
        if not diff.strip():
            raise SystemExit("PR diff가 비어 있습니다. PR 번호와 base/head 상태를 확인해주세요.")
        ensure_diff_size(diff, args.max_diff_bytes)

        prompt = build_prompt(repo, args.pr_number, diff)
        review = review_with_agy(prompt, args.timeout, cwd, args.model)
        body = comment_body(repo, args.pr_number, args.model, review)

        if args.post:
            action = post_or_update_comment(repo, args.pr_number, body, cwd)
            print(f"Antigravity 리뷰 댓글 {action}: {repo}#{args.pr_number}")
        else:
            print(body)
            print("\n--post 옵션을 추가하면 위 내용을 PR 댓글로 생성하거나 갱신합니다.", file=sys.stderr)
    except CommandExecutionError as exc:
        sys.stderr.write(exc.format())
        return exc.returncode

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
